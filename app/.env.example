# Server-only key. Create one at https://www.setlist.fm/settings/api
SETLIST_FM_API_KEY=

# Public OAuth app identifier served to the browser at runtime.
# Create an app at https://developer.spotify.com/dashboard
# Local/Pinokio: add the exact http://127.0.0.1:<port>/api/spotify/callback
# URI shown by Local settings. Public deployments use their root URL instead.
SPOTIFY_CLIENT_ID=
